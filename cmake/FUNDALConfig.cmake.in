@PACKAGE_INIT@

# FUNDAL @PROJECT_VERSION@: backend @FUNDAL_BACKEND@, compiler @CMAKE_Fortran_COMPILER_ID@. Link FUNDAL::fundal.
set(FUNDAL_BACKEND "@FUNDAL_BACKEND@")
set(FUNDAL_MPI @FUNDAL_MPI@)

include(CMakeFindDependencyMacro)
if(FUNDAL_MPI)
  find_dependency(MPI COMPONENTS Fortran)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/FUNDALTargets.cmake")
check_required_components(FUNDAL)
